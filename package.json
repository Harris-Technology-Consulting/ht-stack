{
  "name": "hts",
  "version": "0.1.0",
  "private": true,
  "description": "HT Stack CLI — Harris internal tool for spinning up AI processes",
  "type": "module",
  "bin": {
    "hts": "./bin/hts"
  },
  "scripts": {
    "hts": "bun run src/cli.ts",
    "build": "bun build --compile --outfile=dist/hts ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
